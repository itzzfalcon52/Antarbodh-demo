{
  "version": 8,
  "name": "ANTARBODH Ocean Style",
  "sources": {
    "basemap": {
      "type": "geojson",
      "data": "/assets/countries.geojson"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#071B38"
      }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "basemap",
      "paint": {
        "fill-color": "#14355E"
      }
    },
    {
      "id": "coastline",
      "type": "line",
      "source": "basemap",
      "paint": {
        "line-color": "#5AD2F5",
        "line-width": 1,
        "line-opacity": 0.35
      }
    }
  ]
}